# ---- Sessions, commands and outcomes ----------------------------------------------------------

@final
class Cancel:
    """A cancellation token, which also expires `deadline` seconds from now when given one."""

    def __init__(self, *, deadline: float | None = None) -> None: ...
    def trigger(self) -> None: ...

@final
class Session:
    """An open session. Leaving its `with` block releases the host's share of it."""

    def __init__(
        self,
        server: str,
        *,
        domain: str | None = None,
        username: str | None = None,
        password: str | None = None,
        tls: Tls | None = None,
        ca_certificate: Buffer | None = None,
        seeds: list[str] = ...,
        connect_timeout: float | None = None,
        request_timeout: float | None = None,
        retry_timeout: float | None = None,
        backup_wait_timeout: float | None = None,
        cancel: Cancel | None = None,
    ) -> None: ...
    def __enter__(self) -> Self: ...
    def __exit__(
        self,
        exception_type: type[BaseException] | None,
        exception: BaseException | None,
        traceback: TracebackType | None,
    ) -> bool: ...
    def prepare(self, query: str, *, cancel: Cancel | None = None) -> Execution: ...
    def execute(self, execution: Execution, *, cancel: Cancel | None = None) -> Outcome: ...
    def next_event(self, *, cancel: Cancel | None = None) -> Event: ...
    def next_clock_event(self, *, cancel: Cancel | None = None) -> ClockEvent: ...
    def domain_clock(self, domain: str) -> DomainClock | None: ...
    def suggest(
        self,
        input: str,
        cursor: int,
        page_size: int,
        continuation: str | None = None,
        *,
        cancel: Cancel | None = None,
    ) -> Suggestions: ...
    def open_ingestor(
        self,
        domain: str,
        ingestor: str,
        fields: Fields,
        *,
        batches: int,
        bytes: int,
        cancel: Cancel | None = None,
    ) -> Producer: ...
    def subscribe_emitter(
        self,
        domain: str,
        emitter: str,
        fields: Fields,
        *,
        batches: int,
        bytes: int,
        cancel: Cancel | None = None,
    ) -> Consumer: ...

