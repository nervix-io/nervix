"""The typed surface of `nervix_client`, the Python package of the Nervix client.

The package is an extension module built on pyo3, so a type checker reads its names, signatures
and properties here. `just validate-client-suites` holds every class and member below to the
package's source, in both directions. Every instant is in nanoseconds since the Unix epoch, every
duration a method returns is in nanoseconds, and every timeout or deadline a host passes is in
seconds.
"""

from collections.abc import Buffer
from types import TracebackType
from typing import ClassVar, Final, Protocol, Self, final

class _ArrowArrayExporter(Protocol):
    def __arrow_c_array__(
        self, requested_schema: object | None = None, /
    ) -> tuple[object, object]: ...

class _ArrowStreamExporter(Protocol):
    def __arrow_c_stream__(self, requested_schema: object | None = None, /) -> object: ...

_ArrowData = _ArrowArrayExporter | _ArrowStreamExporter

# ---- Exceptions -------------------------------------------------------------------------------

class ClientError(Exception):
    """A call to the Nervix client failed. Every failure is an instance of one subclass."""

    kind: FailureKind
    message: str
    execution_reference: str | None
    open_refusal: OpenRefusal | None

class InvalidArgumentError(ClientError): ...
class ConnectError(ClientError): ...
class TransportError(ClientError): ...
class UncertainOutcomeError(ClientError): ...
class RejectedError(ClientError): ...
class DeadlineError(ClientError): ...
class CancelledError(ClientError): ...
class EventOverflowError(ClientError): ...
class ProtocolError(ClientError): ...
class TypeMismatchError(ClientError): ...
class ClosedError(ClientError): ...
class ConsumerInterruptedError(ClientError): ...
class ReopenRequiredError(ClientError): ...

