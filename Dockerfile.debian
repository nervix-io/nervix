# syntax=docker/dockerfile:1.7

ARG RUST_VERSION=1.99
ARG KACHE_VERSION=0.28.1
ARG DEBIAN_IMAGE=debian:trixie-20260918-slim@sha256:a99cfc517144bc59b1978475ec53b46ecabec7e43635402ee5b77cc54cd1b20a
ARG LLVM_VERSION=23
ARG FLATBUFFERS_VERSION=25.12.19
ARG FLATBUFFERS_SHA256=f81c3162b1046fe8b84b9a0dbdd383e24fdbcf88583b9cb6028f90d04d90696a

ARG SONIC_PARALLELISM=2
ARG SONIC_TARGET_CPUS=x86-64-v3
# Empty builds the release artifacts. A Deloxide selection, deloxide, deloxide-order or
# deloxide-stress, builds the artifacts of the diagnostic image instead, which only the diagnostic
# target packages: the release targets copy from /artifacts/release and the diagnostic target from
# /artifacts/diagnostic, so a build of either kind cannot produce an image of the other.
ARG NERVIX_DIAGNOSTIC_SELECTION=

FROM --platform=$BUILDPLATFORM ${DEBIAN_IMAGE} AS builder

ARG BUILDPLATFORM
ARG TARGETPLATFORM
ARG BUILDARCH
ARG TARGETARCH
ARG RUST_VERSION
ARG KACHE_VERSION
ARG LLVM_VERSION
ARG FLATBUFFERS_VERSION
ARG FLATBUFFERS_SHA256
ARG SONIC_PARALLELISM
ARG SONIC_TARGET_CPUS
ARG NERVIX_DIAGNOSTIC_SELECTION
ARG KACHE_S3_BUCKET
ARG KACHE_S3_REGION
ARG KACHE_S3_ENDPOINT
ARG KACHE_S3_ACCESS_KEY
ARG KACHE_S3_SECRET_KEY

ENV RUSTUP_HOME=/usr/local/rustup
ENV CARGO_HOME=/usr/local/cargo
ENV PATH=/usr/local/cargo/bin:$PATH
ENV CARGO_INCREMENTAL=0

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        binutils-aarch64-linux-gnu \
        ca-certificates \
        cmake \
        curl \
        g++ \
        g++-aarch64-linux-gnu \
        gcc \
        gcc-aarch64-linux-gnu \
        git \
        gnupg \
        libc6-dev \
        libc6-dev-arm64-cross \
        libssl-dev \
        lsb-release \
        make \
        perl \
        pkg-config \
        protobuf-compiler \
        python3 \
    && rm -rf /var/lib/apt/lists/*

RUN curl -L --proto '=https' --tlsv1.2 -sSf \
    "https://github.com/google/flatbuffers/archive/refs/tags/v${FLATBUFFERS_VERSION}.tar.gz" \
    -o /tmp/flatbuffers.tar.gz \
    && echo "${FLATBUFFERS_SHA256}  /tmp/flatbuffers.tar.gz" | sha256sum --check - \
    && mkdir -p /tmp/flatbuffers-src /tmp/flatbuffers-build \
    && tar -xzf /tmp/flatbuffers.tar.gz -C /tmp/flatbuffers-src --strip-components=1 \
    && cmake -S /tmp/flatbuffers-src -B /tmp/flatbuffers-build \
        -DFLATBUFFERS_BUILD_FLATLIB=OFF \
        -DFLATBUFFERS_BUILD_GRPCTEST=OFF \
        -DFLATBUFFERS_BUILD_SHAREDLIB=OFF \
        -DFLATBUFFERS_BUILD_TESTS=OFF \
        -DFLATBUFFERS_INSTALL=OFF \
    && cmake --build /tmp/flatbuffers-build --target flatc --parallel \
    && install -m 0755 /tmp/flatbuffers-build/flatc /usr/local/bin/flatc \
    && test "$(flatc --version)" = "flatc version ${FLATBUFFERS_VERSION}" \
    && rm -rf /tmp/flatbuffers.tar.gz /tmp/flatbuffers-src /tmp/flatbuffers-build

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --profile minimal --default-toolchain "${RUST_VERSION}" \
    && rustup component add clippy

RUN mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://apt.llvm.org/llvm-snapshot.gpg.key \
    | gpg --dearmor -o /etc/apt/keyrings/llvm.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/llvm.gpg] http://apt.llvm.org/trixie/ llvm-toolchain-trixie-${LLVM_VERSION} main" \
        >/etc/apt/sources.list.d/llvm.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        clang-${LLVM_VERSION} \
        libclang1-${LLVM_VERSION} \
        libclang-${LLVM_VERSION}-dev \
        lld-${LLVM_VERSION} \
        llvm-${LLVM_VERSION} \
    && rm -rf /var/lib/apt/lists/*

RUN curl -L --proto '=https' --tlsv1.2 -sSf \
    https://raw.githubusercontent.com/cargo-bins/cargo-binstall/main/install-from-binstall-release.sh \
    | bash \
    && cargo binstall --no-confirm cargo-auditable \
    && cargo binstall --no-confirm "kache@${KACHE_VERSION}" \
    && cargo binstall --no-confirm trunk \
    && cargo install cargo-sonic

WORKDIR /app

COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY benches/*.rs ./benches/
COPY src ./src
COPY crates ./crates
COPY examples/paced-simulation/rust ./examples/paced-simulation/rust
COPY tests/scenarios.rs ./tests/scenarios.rs
COPY scripts/configure_kache_remote.sh ./scripts/configure_kache_remote.sh
COPY scripts/publish_kache_report.py ./scripts/publish_kache_report.py

ENV CARGO_PROFILE_RELEASE_LTO=fat
ENV CARGO_PROFILE_RELEASE_CODEGEN_UNITS=1
ENV RUSTC_WRAPPER=kache
ENV KACHE_MAX_SIZE=1TiB
ENV KACHE_CACHE_EXECUTABLES=true
ENV KACHE_REMOTE_KEY_LISTING=false

RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,target=/app/target,sharing=locked \
    --mount=type=cache,target=/root/.cache/kache,sharing=locked \
    : "${KACHE_S3_BUCKET:?KACHE_S3_BUCKET is required}" \
    && : "${KACHE_S3_REGION:?KACHE_S3_REGION is required}" \
    && : "${KACHE_S3_ENDPOINT:?KACHE_S3_ENDPOINT is required}" \
    && : "${KACHE_S3_ACCESS_KEY:?KACHE_S3_ACCESS_KEY is required}" \
    && : "${KACHE_S3_SECRET_KEY:?KACHE_S3_SECRET_KEY is required}" \
    && export KACHE_CONFIG=/tmp/kache.toml \
    && bash scripts/configure_kache_remote.sh "${KACHE_CONFIG}" \
    && export KACHE_DAEMON_IDLE_TIMEOUT=0 \
    && export KACHE_MANIFEST_KEY="docker-${TARGETARCH}${NERVIX_DIAGNOSTIC_SELECTION:+-${NERVIX_DIAGNOSTIC_SELECTION}}" \
    && export KACHE_NAMESPACE="${KACHE_MANIFEST_KEY}" \
    && kache daemon start \
    && trap 'build_status=$?; python3 scripts/publish_kache_report.py /tmp/kache-report || true; kache stats || true; kache daemon stop >/dev/null 2>&1 || true; exit "${build_status}"' EXIT \
    && case "${TARGETARCH}" in \
    amd64) export RUST_TARGET=x86_64-unknown-linux-gnu ;; \
    arm64) export RUST_TARGET=aarch64-unknown-linux-gnu ;; \
    *) echo "unsupported TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && case "${TARGETARCH}" in \
    amd64) \
      export CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER=clang-${LLVM_VERSION}; \
      export CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_RUSTFLAGS="-Dwarnings -C link-arg=--target=x86_64-unknown-linux-gnu -C link-arg=-fuse-ld=lld"; \
      export CC_x86_64_unknown_linux_gnu=clang-${LLVM_VERSION}; \
      export CXX_x86_64_unknown_linux_gnu=clang++-${LLVM_VERSION}; \
      export AR_x86_64_unknown_linux_gnu=llvm-ar-${LLVM_VERSION}; \
      export CFLAGS_x86_64_unknown_linux_gnu="--target=x86_64-unknown-linux-gnu"; \
      export CARGO_SONIC_LOADER_RUSTFLAGS="-C link-arg=--target=x86_64-unknown-linux-gnu -C link-arg=-fuse-ld=lld";; \
    arm64) \
      export CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER=clang-${LLVM_VERSION}; \
      export CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_RUSTFLAGS="-Dwarnings -C link-arg=--target=aarch64-unknown-linux-gnu -C link-arg=--gcc-toolchain=/usr -C link-arg=-fuse-ld=lld"; \
      export CC_aarch64_unknown_linux_gnu=clang-${LLVM_VERSION}; \
      export CXX_aarch64_unknown_linux_gnu=clang++-${LLVM_VERSION}; \
      export AR_aarch64_unknown_linux_gnu=llvm-ar-${LLVM_VERSION}; \
      export CFLAGS_aarch64_unknown_linux_gnu="--target=aarch64-unknown-linux-gnu --gcc-toolchain=/usr -I/usr/include/aarch64-linux-gnu"; \
      export CXXFLAGS_aarch64_unknown_linux_gnu="--target=aarch64-unknown-linux-gnu --gcc-toolchain=/usr -I/usr/include/aarch64-linux-gnu"; \
      export CARGO_SONIC_LOADER_RUSTFLAGS="-C link-arg=--target=aarch64-unknown-linux-gnu -C link-arg=--gcc-toolchain=/usr -C link-arg=-fuse-ld=lld";; \
    esac \
    && export LIBCLANG_PATH="$(dirname "$(find /usr -type f \
      \( -name 'libclang.so' -o -name 'libclang.so.*' -o -name 'libclang-*.so' -o -name 'libclang-*.so.*' \) \
      | head -n1)")" \
    && if [ -z "${LIBCLANG_PATH}" ] || [ "${LIBCLANG_PATH}" = "." ]; then \
      echo "failed to locate libclang shared library under /usr" >&2; \
      find /usr -type f | grep -E 'clang|llvm' || true; \
      exit 1; \
    fi \
    && echo "building on ${BUILDPLATFORM} for ${TARGETPLATFORM} (${RUST_TARGET})" \
    && echo "using LIBCLANG_PATH=${LIBCLANG_PATH}" \
    && echo "using cargo-sonic target CPUs: ${SONIC_TARGET_CPUS}" \
    && rustup target add "${RUST_TARGET}" wasm32-unknown-unknown \
    && cd crates/web-console \
    && RUSTFLAGS="-D warnings" trunk build --release \
    && cd /app \
    && case "${NERVIX_DIAGNOSTIC_SELECTION}" in \
    "") \
      cargo sonic --target-cpus="${SONIC_TARGET_CPUS}" --parallelism="${SONIC_PARALLELISM}" --loader bundle --auditable build --release --target "${RUST_TARGET}" --package nervix-server --bin nervix-server \
      && cargo auditable build --release --target "${RUST_TARGET}" --package nervix-cli \
      && cargo auditable build --release --target "${RUST_TARGET}" --package nervix-nspl-format \
      && mkdir -p /artifacts/release \
      && cp "/app/target/sonic/${RUST_TARGET}/release/nervix-server" /artifacts/release/nervix-server \
      && cp -R "/app/target/sonic/${RUST_TARGET}/release/nervix-server.bundle" /artifacts/release/nervix-server.bundle \
      && cp "/app/target/${RUST_TARGET}/release/nervix-cli" /artifacts/release/nervix-cli \
      && cp "/app/target/${RUST_TARGET}/release/nervix-nspl-format" /artifacts/release/nervix-nspl-format;; \
    deloxide | deloxide-order | deloxide-stress) \
      cargo auditable build --release --target "${RUST_TARGET}" --package nervix-server --bin nervix-server --features "${NERVIX_DIAGNOSTIC_SELECTION}" \
      && cargo auditable build --release --target "${RUST_TARGET}" --package nervix-cli \
      && cargo auditable build --release --target "${RUST_TARGET}" --package nervix-nspl-format \
      && cargo auditable build --release --target "${RUST_TARGET}" --package nervix-deadlock --features report-tool --bin nervix-deadlock-report \
      && mkdir -p /artifacts/diagnostic \
      && cp "/app/target/${RUST_TARGET}/release/nervix-server" /artifacts/diagnostic/nervix-server \
      && cp "/app/target/${RUST_TARGET}/release/nervix-cli" /artifacts/diagnostic/nervix-cli \
      && cp "/app/target/${RUST_TARGET}/release/nervix-nspl-format" /artifacts/diagnostic/nervix-nspl-format \
      && cp "/app/target/${RUST_TARGET}/release/nervix-deadlock-report" /artifacts/diagnostic/nervix-deadlock-report;; \
    *) echo "unknown NERVIX_DIAGNOSTIC_SELECTION=${NERVIX_DIAGNOSTIC_SELECTION}" >&2; exit 1 ;; \
    esac \
    && kache save-manifest --manifest-key "${KACHE_MANIFEST_KEY}" --namespace "${KACHE_NAMESPACE}" \
    && kache sync --push

FROM --platform=$BUILDPLATFORM ${DEBIAN_IMAGE} AS onnxruntime-base

ARG TARGETARCH

WORKDIR /tmp

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
    && rm -rf /var/lib/apt/lists/*

COPY scripts/download_onnxruntime.sh /usr/local/bin/download-onnxruntime

FROM onnxruntime-base AS onnxruntime-cpu

RUN case "${TARGETARCH}" in \
        amd64) ort_platform=linux-x64 ;; \
        arm64) ort_platform=linux-aarch64 ;; \
        *) echo "unsupported TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && dylib_path="$(bash /usr/local/bin/download-onnxruntime \
        --flavor cpu \
        --platform "${ort_platform}")" \
    && mkdir -p /onnxruntime \
    && library_dir="$(dirname "${dylib_path}")" \
    && cp -a "${library_dir}/libonnxruntime.so"* /onnxruntime/ \
    && cp -a "${library_dir}/libonnxruntime_providers_shared.so" /onnxruntime/ \
    && rm -rf /tmp/.nervix-deps

FROM onnxruntime-base AS onnxruntime-cuda

RUN case "${TARGETARCH}" in \
        amd64) ;; \
        *) echo "CUDA images require TARGETARCH=amd64" >&2; exit 1 ;; \
    esac \
    && dylib_path="$(bash /usr/local/bin/download-onnxruntime \
        --flavor gpu_cuda13 \
        --platform linux-x64)" \
    && mkdir -p /onnxruntime \
    && library_dir="$(dirname "${dylib_path}")" \
    && cp -a "${library_dir}/libonnxruntime.so"* /onnxruntime/ \
    && cp -a "${library_dir}/libonnxruntime_providers_shared.so" /onnxruntime/ \
    && cp -a "${library_dir}/libonnxruntime_providers_cuda.so" /onnxruntime/ \
    && rm -rf /tmp/.nervix-deps

FROM ${DEBIAN_IMAGE} AS debian-base

# CUDA is the first filesystem layer above Debian. This stage has no Nervix inputs, so changes
# to the server or ONNX Runtime reuse the large CUDA layer.
FROM debian-base AS cuda-base

ARG TARGETARCH

RUN case "${TARGETARCH}" in \
        amd64) ;; \
        *) echo "CUDA images require TARGETARCH=amd64" >&2; exit 1 ;; \
    esac \
    && . /etc/os-release \
    && if [ "${ID}/${VERSION_ID}" != "debian/13" ]; then \
        echo "CUDA images require Debian trixie (13)" >&2; exit 1; \
    fi \
    && apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && curl -L --proto '=https' --tlsv1.2 -sSf \
        https://developer.download.nvidia.com/compute/cuda/repos/debian13/x86_64/cuda-keyring_1.1-1_all.deb \
        -o /tmp/cuda-keyring.deb \
    && echo "d0d4ef986a44400f9db33c600ef33a985175e7cc63d805a10e1839c7a1e78f5f  /tmp/cuda-keyring.deb" | sha256sum --check - \
    && dpkg -i /tmp/cuda-keyring.deb \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        cuda-cudart-13-2=13.2.86-1 \
        cuda-nvrtc-13-2=13.2.86-1 \
        cuda-toolkit-13-2-config-common=13.2.86-1 \
        cuda-toolkit-13-config-common=13.2.86-1 \
        cuda-toolkit-config-common=13.2.86-1 \
        libcublas-13-2=13.4.1.3-1 \
        libcudnn9-cuda-13=9.25.1.1-1 \
        libcurand-13-2=10.4.2.66-1 \
        libnvjitlink-13-2=13.2.86-1 \
    && apt-mark hold \
        cuda-cudart-13-2 \
        cuda-nvrtc-13-2 \
        cuda-toolkit-13-2-config-common \
        cuda-toolkit-13-config-common \
        cuda-toolkit-config-common \
        libcublas-13-2 \
        libcudnn9-cuda-13 \
        libcurand-13-2 \
        libnvjitlink-13-2 \
    && rm -f /tmp/cuda-keyring.deb \
    && rm -rf /var/lib/apt/lists/* \
    && ldconfig

ENV CUDA_VERSION=13.2.2
ENV PATH=/usr/local/nvidia/bin:/usr/local/cuda/bin:$PATH
ENV LD_LIBRARY_PATH=/usr/local/nvidia/lib:/usr/local/nvidia/lib64:/usr/local/cuda/lib64
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility
ENV NVIDIA_REQUIRE_CUDA="cuda>=13.2"

FROM debian-base AS runtime-cpu

RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        libstdc++6 \
        zlib1g \
    && rm -rf /var/lib/apt/lists/*
RUN groupadd --system --gid 10001 nervix \
    && useradd --system --uid 10001 --gid nervix --home-dir /var/lib/nervix --shell /usr/sbin/nologin nervix \
    && mkdir -p /var/lib/nervix \
    && chown -R nervix:nervix /var/lib/nervix
VOLUME ["/var/lib/nervix"]
ENV NERVIX_DB_PATH=/var/lib/nervix/db
ENV ORT_DYLIB_PATH=/usr/local/lib/libonnxruntime.so

COPY --from=onnxruntime-cpu /onnxruntime/ /usr/local/lib/
RUN ldconfig

FROM cuda-base AS runtime-cuda

RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        libstdc++6 \
        zlib1g \
    && rm -rf /var/lib/apt/lists/*
RUN groupadd --system --gid 10001 nervix \
    && useradd --system --uid 10001 --gid nervix --home-dir /var/lib/nervix --shell /usr/sbin/nologin nervix \
    && mkdir -p /var/lib/nervix \
    && chown -R nervix:nervix /var/lib/nervix
VOLUME ["/var/lib/nervix"]
ENV NERVIX_DB_PATH=/var/lib/nervix/db
ENV ORT_DYLIB_PATH=/usr/local/lib/libonnxruntime.so

COPY --from=onnxruntime-cuda /onnxruntime/ /usr/local/lib/
RUN ldconfig

# cuda builds Nervix above the reusable CUDA/cuDNN base.
FROM runtime-cuda AS cuda

COPY --link --from=builder /artifacts/release/nervix-server /usr/local/bin/nervix-server
COPY --link --from=builder /artifacts/release/nervix-server.bundle /usr/local/bin/nervix-server.bundle
COPY --link --from=builder /artifacts/release/nervix-cli /usr/local/bin/nervix-cli
COPY --link --from=builder /artifacts/release/nervix-nspl-format /usr/local/bin/nervix-nspl-format

USER nervix:nervix

CMD ["/usr/local/bin/nervix-server"]

# diagnostic packages the Deloxide diagnostic server, never a release: a test artifact of the
# selection NERVIX_DIAGNOSTIC_SELECTION names, which its label declares, with the ordinary CLI and
# formatter and the evidence report tool beside it. The chaos runner reads the label and judges
# the deadlock evidence every node records.
FROM runtime-cpu AS diagnostic

ARG NERVIX_DIAGNOSTIC_SELECTION

LABEL io.nervix.diagnostic.selection="${NERVIX_DIAGNOSTIC_SELECTION}"

COPY --link --from=builder /artifacts/diagnostic/nervix-server /usr/local/bin/nervix-server
COPY --link --from=builder /artifacts/diagnostic/nervix-cli /usr/local/bin/nervix-cli
COPY --link --from=builder /artifacts/diagnostic/nervix-nspl-format /usr/local/bin/nervix-nspl-format
COPY --link --from=builder /artifacts/diagnostic/nervix-deadlock-report /usr/local/bin/nervix-deadlock-report

USER nervix:nervix

CMD ["/usr/local/bin/nervix-server"]

# cpu builds Nervix on Debian and is the default target.
FROM runtime-cpu AS cpu

COPY --link --from=builder /artifacts/release/nervix-server /usr/local/bin/nervix-server
COPY --link --from=builder /artifacts/release/nervix-server.bundle /usr/local/bin/nervix-server.bundle
COPY --link --from=builder /artifacts/release/nervix-cli /usr/local/bin/nervix-cli
COPY --link --from=builder /artifacts/release/nervix-nspl-format /usr/local/bin/nervix-nspl-format

USER nervix:nervix

CMD ["/usr/local/bin/nervix-server"]