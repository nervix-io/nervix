layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
    tab name="client" {
        pane split_direction="vertical" {
            // A fresh cluster opens its session listener before node-1 has seeded the default
            // user, so the client waits until a statement authenticates. After two minutes it
            // starts anyway, and reports the rejection of a password the state was not seeded with.
            pane command="bash" name="client" {
                args "-lc" "client=(nervix-cli --server https://127.0.0.1:47390 --tls required --tls-ca-cert \"${PWD}/tls/dev/ca.pem\"); echo 'waiting for node-1 to accept the default user'; for _ in $(seq 120); do \"${client[@]}\" --command 'SHOW CLUSTER STATUS;' >/dev/null 2>&1 && break; sleep 1; done; exec \"${client[@]}\""
            }
            pane name="exec"
        }
    }

    tab name="cluster" {
        pane split_direction="vertical" {
            pane command="bash" name="node 1" {
                args "-lc" "exec nervix-server --addr 127.0.0.1:47391 --grpc-mode https --grpc-advertise-addr 127.0.0.1:47391 --grpc-https-listen-addr 127.0.0.1:47390 --grpc-https-advertise-addr 127.0.0.1:47390 --http-listen-addr 127.0.0.1:47400 --https-listen-addr 127.0.0.1:47401 --observability-listen-addr 127.0.0.1:47402 --web-console-listen-addr 127.0.0.1:47420 --web-console-advertise-addr 127.0.0.1:47420 --web-console-https-listen-addr 127.0.0.1:47421 --web-console-tls-cert \"${PWD}/tls/dev/node.pem\" --web-console-tls-key \"${PWD}/tls/dev/node-key.pem\" --node-id node-1 --interconnect-listen-addr 127.0.0.1:47395 --interconnect-advertise-addr 127.0.0.1:47395 --interconnect-tls-ca \"${PWD}/tls/dev/ca.pem\" --interconnect-tls-cert \"${PWD}/tls/dev/node.pem\" --interconnect-tls-key \"${PWD}/tls/dev/node-key.pem\" --allow-bootstrap --db-path \"${PWD}/.nervix-db/node1\""
            }
            pane command="bash" name="node 2" {
                args "-lc" "exec nervix-server --addr 127.0.0.1:48391 --grpc-mode https --grpc-advertise-addr 127.0.0.1:48391 --grpc-https-listen-addr 127.0.0.1:48390 --grpc-https-advertise-addr 127.0.0.1:48390 --http-listen-addr 127.0.0.1:48400 --https-listen-addr 127.0.0.1:48401 --observability-listen-addr 127.0.0.1:48402 --web-console-listen-addr 127.0.0.1:48420 --web-console-advertise-addr 127.0.0.1:48420 --web-console-https-listen-addr 127.0.0.1:48421 --web-console-tls-cert \"${PWD}/tls/dev/node.pem\" --web-console-tls-key \"${PWD}/tls/dev/node-key.pem\" --node-id node-2 --interconnect-listen-addr 127.0.0.1:48395 --interconnect-advertise-addr 127.0.0.1:48395 --interconnect-tls-ca \"${PWD}/tls/dev/ca.pem\" --interconnect-tls-cert \"${PWD}/tls/dev/node-2.pem\" --interconnect-tls-key \"${PWD}/tls/dev/node-2-key.pem\" --cluster-bootstrap-host 127.0.0.1:47395 --db-path \"${PWD}/.nervix-db/node2\""
            }
            pane command="bash" name="node 3" {
                args "-lc" "exec nervix-server --addr 127.0.0.1:49391 --grpc-mode https --grpc-advertise-addr 127.0.0.1:49391 --grpc-https-listen-addr 127.0.0.1:49390 --grpc-https-advertise-addr 127.0.0.1:49390 --http-listen-addr 127.0.0.1:49400 --https-listen-addr 127.0.0.1:49401 --observability-listen-addr 127.0.0.1:49402 --web-console-listen-addr 127.0.0.1:49420 --web-console-advertise-addr 127.0.0.1:49420 --web-console-https-listen-addr 127.0.0.1:49421 --web-console-tls-cert \"${PWD}/tls/dev/node.pem\" --web-console-tls-key \"${PWD}/tls/dev/node-key.pem\" --node-id node-3 --interconnect-listen-addr 127.0.0.1:49395 --interconnect-advertise-addr 127.0.0.1:49395 --interconnect-tls-ca \"${PWD}/tls/dev/ca.pem\" --interconnect-tls-cert \"${PWD}/tls/dev/node-3.pem\" --interconnect-tls-key \"${PWD}/tls/dev/node-3-key.pem\" --cluster-bootstrap-host 127.0.0.1:47395 --db-path \"${PWD}/.nervix-db/node3\""
            }
        }
    }
}
