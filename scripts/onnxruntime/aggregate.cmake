# The top-level include defers discovery until upstream has composed its complete graph.
# Only libraries in that graph enter the combined archive; build tools and unrelated targets do not.
if(CMAKE_CROSSCOMPILING AND onnxruntime_USE_CUDA)
  # Upstream finds CUDA dependencies before enabling the language. FindCUDAToolkit's
  # standalone NVCC probe uses host defaults, so discover the target compiler first.
  enable_language(CUDA)
endif()

function(nervix_cuda_abseil)
  # Clang's preprocessor advertises this host builtin, but NVCC's device frontend lacks it.
  # Supply the same NVCC exclusion the pinned Abseil header uses for its other relocation builtin.
  set(source "${abseil_cpp_SOURCE_DIR}/absl/meta/type_traits.h")
  file(READ "${source}" content)
  set(guard "#if ABSL_HAVE_BUILTIN(__builtin_is_cpp_trivially_relocatable)")
  string(FIND "${content}" "${guard}" position)
  if(position EQUAL -1)
    message(FATAL_ERROR "The pinned Abseil relocation trait does not match the NVCC patch")
  endif()
  string(REPLACE "${guard}" "${guard} && !defined(__NVCC__)" content "${content}")
  set(headers "${CMAKE_BINARY_DIR}/nervix-cuda-includes")
  file(MAKE_DIRECTORY "${headers}/absl/meta")
  file(CONFIGURE OUTPUT "${headers}/absl/meta/type_traits.h" CONTENT "${content}" @ONLY)

  # Clang also advertises class nullability annotations that NVCC's device frontend cannot parse.
  set(source "${abseil_cpp_SOURCE_DIR}/absl/base/nullability.h")
  file(READ "${source}" content)
  set(guard "ABSL_HAVE_FEATURE(nullability_on_classes)")
  string(FIND "${content}" "${guard}" position)
  if(position EQUAL -1)
    message(FATAL_ERROR "The pinned Abseil nullability header does not match the NVCC patch")
  endif()
  string(REPLACE "${guard}" "${guard} && !defined(__NVCC__)" content "${content}")
  file(MAKE_DIRECTORY "${headers}/absl/base")
  file(CONFIGURE OUTPUT "${headers}/absl/base/nullability.h" CONTENT "${content}" @ONLY)

  # NVCC emits lifetimebound annotations in positions that Clang rejects.
  set(source "${abseil_cpp_SOURCE_DIR}/absl/base/attributes.h")
  file(READ "${source}" content)
  set(guard "#if ABSL_HAVE_CPP_ATTRIBUTE(clang::lifetimebound)")
  string(FIND "${content}" "${guard}" position)
  if(position EQUAL -1)
    message(FATAL_ERROR "The pinned Abseil lifetime attribute does not match the NVCC patch")
  endif()
  string(REPLACE "${guard}"
    "#if defined(__NVCC__)\n#define ABSL_ATTRIBUTE_LIFETIME_BOUND\n#elif ABSL_HAVE_CPP_ATTRIBUTE(clang::lifetimebound)"
    content "${content}")
  file(CONFIGURE OUTPUT "${headers}/absl/base/attributes.h" CONTENT "${content}" @ONLY)
  target_include_directories(onnxruntime_providers_cuda BEFORE PRIVATE
    "$<$<COMPILE_LANGUAGE:CUDA>:${headers}>")
endfunction()

function(nervix_cuda_linear_attention)
  set(source "${ONNXRUNTIME_ROOT}/contrib_ops/cuda/bert/linear_attention_impl.cu")
  get_target_property(sources onnxruntime_providers_cuda SOURCES)
  list(FIND sources "${source}" index)
  if(index EQUAL -1)
    message(FATAL_ERROR "The pinned CUDA provider graph does not contain the linear attention source")
  endif()
  file(READ "${source}" content)
  # Explicit generic-lambda return types instantiate NVCC's host wrappers before their
  # generated specializations reach Clang. Deduction retains each lambda's Status result.
  foreach(signature
      "auto launch_col = [&](auto dk_tag) -> Status {"
      "auto launch_decode = [&](auto dk_tag) -> Status {"
      "auto launch_fixed = [&](auto dk_tag, auto dv_tag) -> Status {")
    string(FIND "${content}" "${signature}" position)
    if(position EQUAL -1)
      message(FATAL_ERROR "The pinned linear attention launcher does not match the NVCC correction")
    endif()
    string(REPLACE " -> Status" "" replacement "${signature}")
    string(REPLACE "${signature}" "${replacement}" content "${content}")
  endforeach()
  set(generated "${CMAKE_BINARY_DIR}/nervix-cuda-sources/linear_attention_impl.cu")
  file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/nervix-cuda-sources")
  file(CONFIGURE OUTPUT "${generated}" CONTENT "${content}" @ONLY)
  list(REMOVE_AT sources ${index})
  list(INSERT sources ${index} "${generated}")
  set_property(TARGET onnxruntime_providers_cuda PROPERTY SOURCES "${sources}")
endfunction()

function(nervix_cuda_xqa)
  set(original "${ONNXRUNTIME_ROOT}/contrib_ops/cuda/bert/xqa")
  set(generated "${CMAKE_BINARY_DIR}/nervix-cuda-sources/xqa")
  get_target_property(sources onnxruntime_providers_cuda SOURCES)
  set(rewritten "")
  set(found FALSE)
  foreach(source IN LISTS sources)
    string(FIND "${source}" "${original}/" position)
    if(position EQUAL 0)
      file(RELATIVE_PATH relative "${original}" "${source}")
      list(APPEND rewritten "${generated}/${relative}")
      set(found TRUE)
    else()
      list(APPEND rewritten "${source}")
    endif()
  endforeach()
  if(NOT found)
    return()
  endif()
  file(READ "${original}/utils.cuh" content)
  # NVCC turns this functional aggregate cast into brace initialization in host output.
  # An explicit cast selects CUDA's packed conversion operator and preserves both lanes.
  set(conversion "float2(reinterpret_cast<__nv_fp8x2_e4m3 const&>(src[i]))")
  string(FIND "${content}" "${conversion}" position)
  if(position EQUAL -1)
    message(FATAL_ERROR "The pinned XQA conversion does not match the NVCC correction")
  endif()
  string(REPLACE "${conversion}"
    "static_cast<float2>(reinterpret_cast<__nv_fp8x2_e4m3 const&>(src[i]))" content "${content}")
  # Quoted includes resolve beside each input, so keep the XQA source and header tree together.
  file(GLOB_RECURSE files LIST_DIRECTORIES FALSE RELATIVE "${original}"
    "${original}/*.cu" "${original}/*.cuh" "${original}/*.h")
  foreach(relative IN LISTS files)
    get_filename_component(directory "${generated}/${relative}" DIRECTORY)
    file(MAKE_DIRECTORY "${directory}")
    if(relative STREQUAL "utils.cuh")
      file(CONFIGURE OUTPUT "${generated}/${relative}" CONTENT "${content}" @ONLY)
    else()
      configure_file("${original}/${relative}" "${generated}/${relative}" COPYONLY)
    endif()
  endforeach()
  set_property(TARGET onnxruntime_providers_cuda PROPERTY SOURCES "${rewritten}")
endfunction()

function(nervix_collect_library name)
  if(NOT TARGET "${name}")
    return()
  endif()
  get_target_property(alias "${name}" ALIASED_TARGET)
  if(alias)
    set(name "${alias}")
  endif()
  get_property(visited GLOBAL PROPERTY NERVIX_VISITED_LIBRARIES)
  if("${name}" IN_LIST visited)
    return()
  endif()
  set_property(GLOBAL APPEND PROPERTY NERVIX_VISITED_LIBRARIES "${name}")
  get_target_property(kind "${name}" TYPE)
  get_target_property(imported "${name}" IMPORTED)
  if(kind STREQUAL "STATIC_LIBRARY" AND NOT imported)
    set_property(GLOBAL APPEND PROPERTY NERVIX_ARCHIVE_TARGETS "${name}")
  endif()
  foreach(property LINK_LIBRARIES INTERFACE_LINK_LIBRARIES)
    get_target_property(dependencies "${name}" "${property}")
    if(NOT dependencies)
      continue()
    endif()
    foreach(dependency IN LISTS dependencies)
      if(dependency MATCHES "^\\$<(LINK_ONLY|BUILD_INTERFACE|BUILD_LOCAL_INTERFACE):(.*)>$")
        set(dependency "${CMAKE_MATCH_2}")
      endif()
      nervix_collect_library("${dependency}")
    endforeach()
  endforeach()
endfunction()

function(nervix_static_artifacts)
  nervix_collect_library(onnxruntime)
  get_property(archives GLOBAL PROPERTY NERVIX_ARCHIVE_TARGETS)
  if(NOT archives)
    message(FATAL_ERROR "The ONNX Runtime graph did not contain static libraries")
  endif()
  set(paths "")
  foreach(archive IN LISTS archives)
    string(APPEND paths "$<TARGET_FILE:${archive}>\n")
  endforeach()
  file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/nervix-archives.txt" CONTENT "${paths}")
  if(onnxruntime_USE_CUDA)
    nervix_cuda_abseil()
    nervix_cuda_linear_attention()
    nervix_cuda_xqa()
    list(APPEND archives onnxruntime_providers_shared onnxruntime_providers_cuda)
  endif()
  add_custom_target(nervix_static_artifacts DEPENDS ${archives})
endfunction()

cmake_language(DEFER CALL nervix_static_artifacts)
