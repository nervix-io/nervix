BEGIN;

CREATE RELAY chaos_inspect_records SCHEMA chaos_state_record BRANCHED BY chaos_state_branch CAPACITY 1;

CREATE KAFKA TOPIC INGESTOR chaos_inspect_ingestor
  FROM chaos_kafka TOPIC 'chaos_inspect_input' OFFSET BY CONSUMER GROUP 'chaos_inspect' START AT EARLIEST MODE NO ACK ON QUIESCE SUSPEND
  DECODE USING chaos_state_json
  TO chaos_inspect_records
    INHERIT ALL
    BRANCHED BY chaos_state_branch SET branch_name = message.branch_name
    FLUSH IMMEDIATE
    ON MESSAGE ERROR LOG
  ON GENERAL ERROR LOG;

CREATE RELAY chaos_released SCHEMA chaos_state_record BRANCHED BY chaos_state_branch CAPACITY 1;

CREATE REORDERER chaos_reorderer
  FROM chaos_inspect_records
  ATTACHED
  BY input.sequence
  MAX TIME 1h
  BRANCHED BY chaos_state_branch
  TO chaos_released
    INHERIT ALL
    FLUSH EACH 1h MAX BATCH SIZE 1MiB
    ON MESSAGE ERROR LOG;

CREATE RELAY chaos_settlements SCHEMA chaos_state_record BRANCHED BY chaos_state_branch CAPACITY 1;

CREATE SCHEMA chaos_settlement (
  branch_name STRING,
  sequence I64
);

CREATE RELAY chaos_settled SCHEMA chaos_settlement BRANCHED BY chaos_state_branch CAPACITY 1;

CREATE CORRELATOR chaos_correlator
  LEFT FROM chaos_inspect_records
  RIGHT FROM chaos_settlements
  ATTACHED
  CORRELATE WHERE left.sequence = right.sequence
  MATCH EARLIEST
  MAX TIME 1h
  ON CORRELATION TIMEOUT DROP, DROP
  BRANCHED BY chaos_state_branch
  TO chaos_settled
    SET branch_name = left.branch_name,
        sequence = left.sequence
    FLUSH IMMEDIATE
    ON MESSAGE ERROR LOG;

COMMIT;
