BEGIN;

CREATE SCHEMA chaos_binding_row (
  event_id STRING,
  sequence U64,
  content STRING
);
CREATE RELAY chaos_binding_records SCHEMA chaos_binding_row UNBRANCHED CAPACITY 1;
CREATE CLIENT PRODUCER INGESTOR chaos_binding_in
  FROM SCHEMA chaos_binding_row MODE ACK SEQUENTIAL ACK TIMEOUT 30s RETRY POLICY BACKOFF 100ms MAX 1s ON QUIESCE SUSPEND
  TIMESTAMP NOW
  TO chaos_binding_records
    INHERIT ALL
    UNBRANCHED
    FLUSH IMMEDIATE
    ON MESSAGE ERROR LOG
  ON GENERAL ERROR LOG;

CREATE CLIENT CONSUMER EMITTER chaos_binding_out
  FROM chaos_binding_records
  ATTACHED
  TO SCHEMA chaos_binding_row
    MODE ACK SEQUENTIAL ACK TIMEOUT 30s RETRY POLICY BACKOFF 100ms MAX 1s
  INHERIT ALL
  BATCH MAX MESSAGES 16 MAX SIZE 256KiB
  FLUSH IMMEDIATE
  ON MESSAGE ERROR LOG
  ON GENERAL ERROR LOG;

COMMIT;
