BEGIN;

CREATE SCHEMA chaos_inferred_total (
  branch_name STRING,
  score ARRAY<F32, 1>
);

CREATE WIRE JSON SCHEMA chaos_inferred_wire MODE STRICT (
  branch_name STRING,
  score ARRAY
);

CREATE WIRE JSON CODEC chaos_inferred_json
  FROM WIRE SCHEMA chaos_inferred_wire
  TO SCHEMA chaos_inferred_total;

CREATE RELAY chaos_inferred SCHEMA chaos_inferred_total BRANCHED BY chaos_state_branch CAPACITY 1;

CREATE INFERENCER chaos_running
  FROM chaos_state_records
  ATTACHED
  USING RESOURCE chaos_running_model VERSION 1
  FILE 'models/running_sum.onnx'
  INPUTS {
    'features' DENSE TENSOR<F32>[2] = [1 AS F32, 0 AS F32]
  }
  STATE {
    'state_in' FROM 'state_out' DENSE TENSOR<F32>[2] INITIAL ZEROS
  }
  OUTPUT SCHEMA {
    'score' DENSE TENSOR<F32>[1]
  }
  BRANCHED BY chaos_state_branch
  TO chaos_inferred
    SET branch_name = branch.branch_name,
        score = score
    FLUSH IMMEDIATE
    ON MESSAGE ERROR LOG;

CREATE KAFKA TOPIC EMITTER chaos_inferred_emitter
  FROM chaos_inferred
  ATTACHED
  TO chaos_kafka TOPIC 'chaos_inferred_output'
    MODE ACK SEQUENTIAL ACK TIMEOUT 30s RETRY POLICY BACKOFF 200ms MAX 5s
    ENCODE USING chaos_inferred_json
  INHERIT ALL
  FLUSH IMMEDIATE
  ON MESSAGE ERROR LOG
  ON GENERAL ERROR LOG;

COMMIT;
