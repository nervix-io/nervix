{
  "apis": [
    {
      "receivers": [
        "lock_api::mutex::Mutex",
        "lock_api::remutex::ReentrantMutex"
      ],
      "defining_crates": [
        "lock_api"
      ],
      "operations": {
        "lock": "exclusive",
        "lock_arc": "exclusive",
        "try_lock": "try_exclusive",
        "try_lock_for": "try_exclusive",
        "try_lock_until": "try_exclusive",
        "try_lock_arc": "try_exclusive",
        "try_lock_arc_for": "try_exclusive",
        "try_lock_arc_until": "try_exclusive"
      },
      "rationale": "The resolved lock_api operation acquires the selected raw mutex, including parking_lot and Shuttle backends. Access through get_mut or a held guard adds no acquisition."
    },
    {
      "receivers": [
        "lock_api::rwlock::RwLock"
      ],
      "defining_crates": [
        "lock_api"
      ],
      "operations": {
        "read": "shared",
        "read_arc": "shared",
        "write": "exclusive",
        "write_arc": "exclusive",
        "upgradable_read": "exclusive",
        "upgradable_read_arc": "exclusive",
        "try_read": "try_shared",
        "try_read_arc": "try_shared",
        "try_read_for": "try_shared",
        "try_read_until": "try_shared",
        "try_write": "try_exclusive",
        "try_write_arc": "try_exclusive",
        "try_write_for": "try_exclusive",
        "try_write_until": "try_exclusive",
        "try_upgradable_read": "try_exclusive",
        "try_upgradable_read_for": "try_exclusive",
        "try_upgradable_read_until": "try_exclusive",
        "try_upgradable_read_arc": "try_exclusive",
        "try_upgradable_read_arc_for": "try_exclusive",
        "try_upgradable_read_arc_until": "try_exclusive"
      },
      "rationale": "Read and write guards acquire the selected raw RwLock. Upgradable guards reserve exclusive upgrade ownership. Try calls still attempt synchronization."
    },
    {
      "receivers": [
        "tokio::sync::mutex::Mutex",
        "shuttle_tokio_impl_inner::sync::mutex::Mutex",
        "shuttle::future::mutex::Mutex"
      ],
      "defining_crates": [
        "tokio",
        "shuttle_tokio_impl_inner",
        "shuttle"
      ],
      "operations": {
        "lock": "exclusive",
        "lock_owned": "exclusive",
        "blocking_lock": "exclusive",
        "blocking_lock_owned": "exclusive",
        "try_lock": "try_exclusive",
        "try_lock_owned": "try_exclusive"
      },
      "rationale": "Acquiring an async mutex or its owned guard synchronizes; creating the returned future defers acquisition until polling."
    },
    {
      "receivers": [
        "tokio::sync::rwlock::RwLock",
        "shuttle_tokio_impl_inner::sync::rwlock::RwLock",
        "shuttle::future::rwlock::RwLock"
      ],
      "defining_crates": [
        "tokio",
        "shuttle_tokio_impl_inner",
        "shuttle"
      ],
      "operations": {
        "read": "shared",
        "read_owned": "shared",
        "write": "exclusive",
        "write_owned": "exclusive",
        "blocking_read": "shared",
        "blocking_write": "exclusive",
        "try_read": "try_shared",
        "try_read_owned": "try_shared",
        "try_write": "try_exclusive",
        "try_write_owned": "try_exclusive"
      },
      "rationale": "Async read/write guards acquire the corresponding side, including owned and try APIs."
    },
    {
      "receivers": [
        "std::sync::poison::mutex::Mutex",
        "shuttle::sync::mutex::Mutex",
        "loom::sync::mutex::Mutex"
      ],
      "defining_crates": [
        "std",
        "shuttle",
        "loom"
      ],
      "operations": {
        "lock": "exclusive",
        "try_lock": "try_exclusive"
      },
      "rationale": "The concrete blocking mutex API acquires or tries to acquire its backend lock."
    },
    {
      "receivers": [
        "std::sync::poison::rwlock::RwLock",
        "shuttle::sync::rwlock::RwLock",
        "loom::sync::rwlock::RwLock"
      ],
      "defining_crates": [
        "std",
        "shuttle",
        "loom"
      ],
      "operations": {
        "read": "shared",
        "write": "exclusive",
        "try_read": "try_shared",
        "try_write": "try_exclusive"
      },
      "rationale": "The concrete blocking RwLock API acquires or tries to acquire its backend lock."
    },
    {
      "receivers": [
        "dashmap::DashMap",
        "shuttle_dashmap_impl::DashMap"
      ],
      "defining_crates": [
        "dashmap",
        "shuttle_dashmap_impl"
      ],
      "operations": {
        "get": "shared",
        "contains_key": "shared",
        "iter": "shared",
        "len": "shared",
        "is_empty": "shared",
        "capacity": "shared",
        "view": "shared",
        "get_mut": "exclusive",
        "entry": "exclusive",
        "insert": "exclusive",
        "remove": "exclusive",
        "remove_if": "exclusive",
        "remove_if_mut": "exclusive",
        "iter_mut": "exclusive",
        "retain": "exclusive",
        "clear": "exclusive",
        "alter": "exclusive",
        "alter_all": "exclusive",
        "shrink_to_fit": "exclusive",
        "try_get": "try_shared",
        "try_get_mut": "try_exclusive",
        "try_entry": "try_exclusive",
        "clone": "shared",
        "extend": "exclusive",
        "into_iter": "shared",
        "try_reserve": "exclusive"
      },
      "rationale": "DashMap borrowed reads and iteration take shard read guards; mutation takes shard write guards. Iteration acquires lazily while advancing; try calls are acquisition attempts. Held guards and consuming iteration do not add an acquisition."
    },
    {
      "receivers": [
        "nervix_primitives::collections::scheduled::DashMap"
      ],
      "defining_crates": [
        "nervix_primitives"
      ],
      "operations": {
        "into_iter": "shared"
      },
      "rationale": "The primitive Shuttle adapter forwards borrowed iteration to the modeled DashMap. Its authored caller creates a lazy shard-read iterator; consuming iteration is unavailable in this mode."
    }
  ]
}
