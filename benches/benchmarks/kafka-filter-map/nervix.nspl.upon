BEGIN;
CREATE SCHEMA benchmark_record (
  value STRING
);
CREATE WIRE JSON SCHEMA benchmark_wire MODE STRICT (
  value string
);
CREATE CODEC benchmark_codec
  FROM WIRE JSON SCHEMA benchmark_wire
  TO SCHEMA benchmark_record;
CREATE CLIENT kafka_input
  TYPE KAFKA
  CONFIG {
    'bootstrap.servers' = '{{ kafka_bootstrap_servers }}',
    'auto.offset.reset' = 'earliest'
  };
CREATE CLIENT kafka_output
  TYPE KAFKA
  CONFIG {
    'bootstrap.servers' = '{{ kafka_bootstrap_servers }}',
    'enable.idempotence' = 'true',
    'acks' = 'all'
  };
{% for lane in lanes %}
CREATE RELAY benchmark_ingested_{{ lane }} SCHEMA benchmark_record UNBRANCHED;
CREATE RELAY benchmark_records_{{ lane }} SCHEMA benchmark_record UNBRANCHED;
CREATE INGESTOR kafka_in_{{ lane }}
  FROM KAFKA kafka_input
  TOPIC {{ input_topic }}
  OFFSET BY CONSUMER GROUP {{ consumer_group }}
  INSTANCES 1
  MODE {{ parameters.ingestor_mode }}
  ON QUIESCE SUSPEND DECODE USING benchmark_codec
  TO benchmark_ingested_{{ lane }}
    INHERIT ALL
    UNBRANCHED
    FLUSH EACH {{ parameters.ingestor_flush_each }} MAX BATCH SIZE {{ parameters.ingestor_max_batch_size }}
    ON MESSAGE ERROR LOG
  ON GENERAL ERROR LOG;
CREATE JUNCTION benchmark_transform_{{ lane }}
  FROM benchmark_ingested_{{ lane }}
  FILTER WHERE contains(input.value, "x")
  UNBRANCHED
  TO benchmark_records_{{ lane }}
    SET value = upper(input.value)
    FLUSH IMMEDIATE
    ON MESSAGE ERROR LOG;
CREATE EMITTER kafka_out_{{ lane }}
  FROM benchmark_records_{{ lane }}
  TO KAFKA kafka_output TOPIC {{ output_topic }}
    MODE NO_ACK RETRY POLICY BACKOFF 250ms MAX 30s
    ENCODE USING benchmark_codec
  INHERIT ALL
  FLUSH EACH {{ parameters.emitter_flush_each }} MAX BATCH SIZE {{ parameters.emitter_max_batch_size }}
  ON MESSAGE ERROR LOG
  ON GENERAL ERROR LOG;
{% endfor %}
COMMIT;
